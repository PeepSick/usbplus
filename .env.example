# USB — local environment template.
# Copy to `.env` and adjust. Nothing here is a secret — the values mirror
# docker-compose.yml's local defaults (cp .env.example .env).

# Postgres connection for host-run commands (`npm run dev`, `npm run build`,
# `npx drizzle-kit push`). By default it points at the Postgres that
# `docker compose up -d` publishes on the host (USB_PG_HOST_PORT, 5433):
DATABASE_URL="postgres://usb:usb_secret_change_me@127.0.0.1:5433/usb"

# Running without Docker? Point this at any Postgres 14+ you own.
# `npm run build` only needs a reachable URL for its page-data collection
# step; CI (GitHub Actions) simply passes a dummy localhost URL for that.

# Opt-in anonymous install logging of the self-hosted site (default off):
# USB_LOG_INSTALLATIONS=on
