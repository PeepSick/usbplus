#!/usr/bin/env node
// usb — Node launcher for the bash implementation (bin/usb.sh).
//
// Why this exists: npm's global-install shim on Windows resolves the bin
// entry's shebang. A bare "#!/usr/bin/env bash" shim calls "bash.exe" via
// PATH only — but Git for Windows' default install adds Git\cmd and
// Git\mingw64\bin to PATH, NOT Git\usr\bin, where bash.exe actually lives.
// Result: "usb install" fails with CommandNotFoundException even though
// Git (and bash) is installed. Node is guaranteed present (npm needs it),
// so this launcher finds bash reliably and execs the real script.

import { spawnSync } from "node:child_process";
import path from "node:path";
import fs from "node:fs";
import { fileURLToPath } from "node:url";

const __dirname = path.dirname(fileURLToPath(import.meta.url));

const scriptPath = path.join(__dirname, "usb.sh");

function findBash() {
  if (process.platform !== "win32") return "bash";

  // WSL (System32) and the Microsoft Store (WindowsApps) ship bash.exe
  // stubs that CANNOT run a Windows script path: they forward the argument
  // to the Linux side, which eats the backslashes ("C:\Users\..." arrives as
  // "C:Users...") and fails with a cryptic No-such-file error. Never pick
  // those — we need a Windows-native (MSYS/Cygwin) bash.
  const isStub = (p) =>
    /[\\/]System32[\\/]bash\.exe$/i.test(p) ||
    /[\\/]SysWOW64[\\/]bash\.exe$/i.test(p) ||
    /[\\/]WindowsApps[\\/]bash\.exe$/i.test(p);

  // 1. Git for Windows — the real thing; its MSYS bash understands
  //    "C:\..." script paths natively. Preferred over anything on PATH.
  const gitCandidates = [
    process.env.ProgramFiles && path.join(process.env.ProgramFiles, "Git", "bin", "bash.exe"),
    process.env.ProgramFiles && path.join(process.env.ProgramFiles, "Git", "usr", "bin", "bash.exe"),
    process.env["ProgramFiles(x86)"] && path.join(process.env["ProgramFiles(x86)"], "Git", "bin", "bash.exe"),
    process.env.LOCALAPPDATA && path.join(process.env.LOCALAPPDATA, "Programs", "Git", "bin", "bash.exe"),
    process.env.LOCALAPPDATA && path.join(process.env.LOCALAPPDATA, "Programs", "Git", "usr", "bin", "bash.exe"),
  ].filter(Boolean);
  const gitBash = gitCandidates.find((p) => fs.existsSync(p));
  if (gitBash) return gitBash;

  // 2. Any other bash on PATH that is not a WSL/Store stub (Cygwin, MSYS2…).
  const onPath = spawnSync("where", ["bash.exe"], { encoding: "utf8" });
  if (onPath.status === 0) {
    const first = onPath.stdout
      .split(/\r?\n/)
      .filter(Boolean)
      .find((p) => !isStub(p));
    if (first) return first.trim();
  }

  // 3. Only WSL was found — fail with instructions instead of a cryptic
  //    path error from the Linux side.
  return null;
}

const bash = findBash();

if (!bash) {
  console.error("usb: couldn't find a Windows-native bash.\n");
  console.error("usb's CLI is a bash script. On Windows, install Git for Windows");
  console.error("(https://git-scm.com/download/win) — it ships bash.exe — or run");
  console.error("usb from inside WSL with the project checked out on the Linux side.\n");
  process.exit(1);
}

const result = spawnSync(bash, [scriptPath, ...process.argv.slice(2)], {
  stdio: "inherit",
});

if (result.error) {
  console.error(`usb: failed to launch bash (${bash}): ${result.error.message}`);
  process.exit(1);
}

process.exit(result.status === null ? 1 : result.status);
